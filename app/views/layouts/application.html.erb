<!DOCTYPE html>
<html>
  <head>
    <title><%= I18n.t(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="<%= asset_path("favicon.ico") %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path("favicon.ico") %>">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%# To add turbo integration puts "data-turbo-track": "reload" on stylesheet and javascript link tags %>
    <%= javascript_include_tag "application", type: "module" %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <% sidebar_collapsed = cookies['sidebarCollapsed'] == 'true' %>
    <div class="app-container">
      <aside id="sidebar" class="sidebar<%= ' collapsed' if sidebar_collapsed %>" role="navigation" aria-label="Main navigation">
        <div class="sidebar-header">
          <button id="sidebarToggle" class="sidebar-toggle" aria-label="Toggle sidebar" aria-expanded="true">
            <i class="bi bi-list"></i>
          </button>
          <div class="brand">
            <%= image_tag "logo-rd.png", id: "logo", alt: I18n.t(:logo_rd_alt_image), class: "brand-logo" %>
            <span class="brand-text"><%= I18n.t(:title) %></span>
          </div>
        </div>

        <nav class="sidebar-nav">
          <ul class="nav-list">
            <li class="nav-item">
              <%= link_to root_path, class: "nav-link" do %>
                <i class="bi bi-house-fill nav-icon"></i>
                <span class="nav-text"><%= I18n.t(:home) %></span>
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to new_main_sale_path, class: "nav-link" do %>
                <i class="bi bi-cart4 nav-icon"></i>
                <span class="nav-text"><%= I18n.t(:sale, scope: %i[activerecord models], count: 1) %></span>
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to main_products_path, class: "nav-link" do %>
                <i class="bi bi-grid nav-icon"></i>
                <span class="nav-text"><%= I18n.t(:product, scope: %i[activerecord models], count: 2) %></span>
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to main_customers_path, class: "nav-link" do %>
                <i class="bi bi-person-circle nav-icon"></i>
                <span class="nav-text"><%= I18n.t(:customer, scope: %i[activerecord models], count: 2) %></span>
              <% end %>
            </li>
          </ul>
        </nav>

        <div class="sidebar-footer">
          <div class="user-menu">
            <button class="user-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
              <%= image_tag "logo-rd.png", alt: I18n.t(:logo_rd_alt_image), class: "user-avatar" %>
              <div class="user-info">
                <span class="user-name"><%= current_user&.name&.capitalize %></span>
                <i class="bi bi-chevron-up dropdown-arrow"></i>
              </div>
            </button>
            <ul class="dropdown-menu user-dropdown ms-2 mb-1" aria-labelledby="dropdownUser">
              <% if current_user&.admin? %>
                <li>
                  <%= link_to I18n.t(:sale, scope: %i[activerecord models], count: 2), main_sales_path, class: "dropdown-item" %>
                </li>
                <li><hr class="dropdown-divider"></li>
              <% end %>
              <li>
                <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                  <i class="bi bi-box-arrow-right me-2"></i>
                  <%= I18n.t(:exit) %>
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </aside>

      <main id="content" class="main-content<%= ' expanded' if sidebar_collapsed %>">
        <div class="content-wrapper">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
