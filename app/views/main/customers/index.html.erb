<div class="container-fluid">
  <!-- Page Header -->
  <div class="customers-index-header">
    <div class="customers-index-title-section">
      <h1 class="customers-index-title">
        <i class="bi bi-people-fill customers-index-title-icon"></i>
        <%= I18n.t(:customer, scope: %i[activerecord models], count: 2) %>
      </h1>
      <p class="customers-index-subtitle"><%= I18n.t(:customers_index_subtitle) %></p>
    </div>
    <div class="customers-index-actions">
      <%= link_to new_main_customer_path, class: "customers-index-btn-primary" do %>
        <i class="bi bi-plus-circle customers-index-btn-icon"></i>
        <%= I18n.t(:add, scope: %i[activerecord], model: Customer.model_name.human) %>
      <% end %>
    </div>
  </div>

  <!-- Filters Section -->
  <div class="customers-index-filters-card">
    <div class="customers-index-filters-header">
      <h3 class="customers-index-filters-title">
        <i class="bi bi-funnel customers-index-filters-icon"></i>
        <%= I18n.t(:search_filters) %>
      </h3>
    </div>
    <div class="customers-index-filters-grid">
      <div class="customers-index-filter-group">
        <label for="search_name" class="customers-index-filter-label">
          <i class="bi bi-person customers-index-filter-label-icon"></i>
          <%= I18n.t(:search_by_name) %>
        </label>
        <input type="text" id="search_name" class="customers-index-filter-input" placeholder="<%= I18n.t(:customer_name_placeholder) %>">
      </div>
      <div class="customers-index-filter-group">
        <label for="search_matriculation" class="customers-index-filter-label">
          <i class="bi bi-card-text customers-index-filter-label-icon"></i>
          <%= I18n.t(:matriculation, scope: %i[activerecord attributes customer]) %>
        </label>
        <input type="text" id="search_matriculation" class="customers-index-filter-input" placeholder="<%= I18n.t(:matriculation_placeholder) %>">
      </div>
      <div class="customers-index-filter-group">
        <label for="search_status" class="customers-index-filter-label">
          <i class="bi bi-toggle-on customers-index-filter-label-icon"></i>
          <%= I18n.t(:status, scope: %i[activerecord attributes customer]) %>
        </label>
        <select id="search_status" class="customers-index-filter-select">
          <option value=""><%= I18n.t(:select_status) %></option>
          <option value="active"><%= I18n.t(:active) %></option>
          <option value="inactive"><%= I18n.t(:inactive) %></option>
        </select>
      </div>
    </div>
  </div>

  <!-- Customers Table -->
  <div class="customers-index-table-card">
    <div class="customers-index-table-header">
      <h3 class="customers-index-table-title">
        <i class="bi bi-table customers-index-table-title-icon"></i>
        <%= I18n.t(:customers_list) %>
      </h3>
    </div>
    <div class="customers-index-table-responsive">
      <table class="customers-index-table">
        <thead class="customers-index-thead">
          <tr class="customers-index-tr">
            <th class="customers-index-th customers-index-th-id">
              <i class="bi bi-hash customers-index-th-icon"></i>
              ID
            </th>
            <th class="customers-index-th customers-index-th-name">
              <i class="bi bi-person customers-index-th-icon"></i>
              <%= I18n.t(:name, scope: %i[activerecord attributes customer]) %>
            </th>
            <th class="customers-index-th customers-index-th-status">
              <i class="bi bi-toggle-on customers-index-th-icon"></i>
              <%= I18n.t(:status, scope: %i[activerecord attributes customer]) %>
            </th>
            <th class="customers-index-th customers-index-th-actions">
              <i class="bi bi-gear customers-index-th-icon"></i>
              <%= I18n.t(:actions) %>
            </th>
          </tr>
        </thead>
        <tbody class="customers-index-tbody" id="customers">
          <% if @customers.any? %>
            <% @customers.each do |customer| %>
              <tr class="customers-index-tr customer-row">
                <td class="customers-index-td customers-index-td-id">
                  <span class="customers-index-customer-id">#<%= customer.id %></span>
                </td>
                <td class="customers-index-td customers-index-td-name">
                  <div class="customers-index-customer-info">
                    <div class="customers-index-customer-avatar">
                      <% if customer.avatar.attached? %>
                        <%= image_tag customer.avatar, class: "customers-index-avatar-img" %>
                      <% else %>
                        <i class="bi bi-person-circle customers-index-avatar-icon"></i>
                      <% end %>
                    </div>
                    <div class="customers-index-customer-details">
                      <span class="customers-index-customer-name"><%= customer.name %></span>
                      <span class="customers-index-customer-matriculation"><%= I18n.t(:matriculation_short) %>: <%= customer.matriculation %></span>
                    </div>
                  </div>
                </td>
                <td class="customers-index-td customers-index-td-status">
                  <% if customer.active? %>
                    <span class="customers-index-status-badge customers-index-status-active">
                      <i class="bi bi-check-circle-fill customers-index-status-icon"></i>
                      <%= I18n.t(:active) %>
                    </span>
                  <% else %>
                    <span class="customers-index-status-badge customers-index-status-inactive">
                      <i class="bi bi-x-circle-fill customers-index-status-icon"></i>
                      <%= I18n.t(:inactive) %>
                    </span>
                  <% end %>
                </td>
                <td class="customers-index-td customers-index-td-actions">
                  <div class="customers-index-action-buttons">
                    <%= link_to main_customer_path(customer), class: "customers-index-btn-action customers-index-btn-view" do %>
                      <i class="bi bi-eye customers-index-btn-action-icon"></i>
                      <span class="customers-index-btn-action-text"><%= I18n.t(:show) %></span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr class="customers-index-tr">
              <td colspan="4" class="customers-index-td text-center">
                <div class="customers-index-empty-state">
                  <i class="bi bi-people customers-index-empty-icon"></i>
                  <h3 class="customers-index-empty-title"><%= I18n.t(:no_customers_found) %></h3>
                  <p class="customers-index-empty-description"><%= I18n.t(:add_first_customer) %></p>
                  <%= link_to new_main_customer_path, class: "customers-index-btn-primary" do %>
                    <i class="bi bi-plus-circle customers-index-btn-icon"></i>
                    <%= I18n.t(:add_first_customer_btn) %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
