<p style="color: green"><%= notice %></p>
<h1><%= I18n.t(:customer, scope: %i[activerecord models], count: 2) %></h1>
<hr>
<%= link_to I18n.t(:add, scope: %i[activerecord], model: Customer.model_name.human), new_main_customer_path %>
<input type="text" id="search_name" placeholder="<%= I18n.t(:search_by_name) %>">
<input type="text" id="search_id" placeholder="<%= I18n.t(:matriculation, scope: %i[activerecord attributes customer]) %>">
<select id="search_status">
  <option value=""><%= I18n.t(:select_status) %></option>
  <option value="active"><%= I18n.t(:active) %></option>
  <option value="inactive"><%= I18n.t(:inactive) %></option>
</select>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th><%= I18n.t(:name, scope: %i[activerecord attributes customer]) %></th>
      <th><%= I18n.t(:status, scope: %i[activerecord attributes customer]) %></th>
      <th><%= I18n.t(:actions) %></th>
    </tr>
  </thead>
  <tbody id="customers">
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.id %></td>
        <td><%= customer.name %></td>
        <td>
          <% if customer.active? %>
            <span><%= I18n.t(:active) %></span>
          <% else %>
            <span><%= I18n.t(:inactive) %></span>
          <% end %>
        </td>
        <td><%= link_to I18n.t(:show, scope: %i[activerecord], model: Customer.model_name.human), main_customer_path(customer) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
