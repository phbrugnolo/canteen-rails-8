<div class="container">
  <h1 class="m-3"><%= I18n.t(:sale, scope: %i[activerecord models], count: 1) %></h1>
  <hr>
  <div id="products"></div>
  <div>
    <div>
      <div id="cart"></div>
    </div>
    <div>
      <%= render "form", sale: @sale %>
    </div>
  </div>
  <br>
</div>

<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const salesManager = new SalesManager();
    const apiEndpoint = "<%= new_main_sale_path(format: :json) %>";

    await salesManager.initialize(apiEndpoint);

    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', (event) => {
        if (!salesManager.validateForm()) event.preventDefault();
      });
    }
  });
</script>
