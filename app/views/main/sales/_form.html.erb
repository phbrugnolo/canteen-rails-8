<%= simple_form_for [:main, @sale] do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <!-- Customer Selection -->
  <div class="mb-4">
    <label class="sale-new-form-label fw-semibold text-dark mb-2">
      <i class="bi bi-person me-1"></i>
      <%= I18n.t(:customer) %>
    </label>
    <%= f.association :customer,
          collection: @customers,
          label_method: :name,
          value_method: :id,
          input_html: {
            id: "customer-id",
            class: "sale-new-form-select",
            style: "border-radius: 8px;"
          },
          label: false,
          include_blank: false,
          prompt: I18n.t(:select_a_customer) %>
  </div>

  <!-- Hidden Cart Data -->
  <%= f.input :cart, as: :hidden, input_html: { value: "" }, error: "", label: false %>

  <!-- Total Price Display -->
  <div class="mb-4">
    <label class="sale-new-form-label fw-semibold text-dark mb-2">
      <i class="bi bi-currency-dollar me-1"></i>
      <%= I18n.t(:total_price) %>
    </label>
    <div class="input-group" style="border-radius: 8px; overflow: hidden;">
      <span class="input-group-text bg-light border-end-0 fw-bold text-success">R$</span>
      <%= f.text_field :total_price,
            readonly: true,
            class: "sale-new-form-control border-start-0 bg-light fw-bold text-success fs-5 text-end",
            style: "font-family: 'Courier New', monospace;" %>
    </div>
    <small class="text-muted mt-1 d-block">
      <i class="bi bi-info-circle me-1"></i>
      <%= I18n.t(:automatically_calculated_value) %>
    </small>
  </div>

  <!-- Submit Button -->
  <div class="d-grid">
    <%= f.submit I18n.t(:close_sale),
          class: "btn btn-success btn-lg fw-semibold py-3",
          style: "border-radius: 8px; box-shadow: 0 4px 12px rgba(25, 135, 84, 0.3);" %>
  </div>
<% end %>
