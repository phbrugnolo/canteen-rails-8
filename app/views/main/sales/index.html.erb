<p style="color: green"><%= notice %></p>
<h1 class="mx-2 mt-2"><%= I18n.t(:sale, scope: %i[activerecord models], count: 2) %></h1>
<hr>
<div id="sales">
  <div class="card p-2 mt-4" style="background-color: #EEF5FF">
    <div class="container">
      <% if @sales.size > 0 %>
        <div class="row mb-2 mt-4">
          <div class="col-md-6">
            <input type="text" id="search_name" class="form-control" placeholder="<%= I18n.t(:search_by_name) %>">
          </div>
          <div class="col-md-3">
            <input type="date" id="search_date" class="form-control" placeholder="<%= I18n.t(:created_at, scope: %i[activerecord attributes sales]) %>">
          </div>
        </div>
        <div class="row">
          <% @sales.order(created_at: :desc).each do |sale| %>
            <div class="col-6">
              <div class="card border-info m-4 p-2" style="position: relative;">
                <table class="table mb-0 mt-1">
                  <tr class="list-group list-group-flush table-row">
                    <td><%= I18n.t(:date) %>: <%= sale.created_at.strftime("%d/%m/%Y") %></td>
                    <td><%= I18n.t(:customer, scope: %i[activerecord models], count: 1) %>: <%= sale.customer.name %></td>
                    <td><%= I18n.t(:total_price) %>: <%= number_to_currency(sale.total_price) %></td>
                    <td class="border-bottom-0 d-flex justify-content-end flex-column">
                      <%= link_to I18n.t(:show_sale), main_sale_path(sale), class: "btn btn-primary show-cart my-2" %>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const nameInput = document.getElementById("search_name");
    const dateInput = document.getElementById("search_date");
    const saleCards = document.querySelectorAll("#sales .card.border-info");
    const container = document.querySelector("#sales > .card.p-2 .container");

    const noSalesMessage = document.createElement("p");
    noSalesMessage.textContent = "<%= I18n.t(:no_purchases_found) %>";
    noSalesMessage.className = "mx-2 mt-2 text-center text-muted";
    noSalesMessage.style.display = "none";
    container.appendChild(noSalesMessage);

    function filterSales() {
      let hasVisibleItems = false;
      const searchName = nameInput.value.trim().toLowerCase();
      const searchDate = dateInput.value;

      saleCards.forEach(card => {
        // Extrai dados da venda
        const dateCell = card.querySelector("td:nth-child(1)");
        const customerCell = card.querySelector("td:nth-child(2)");

        // Formata data para YYYY-MM-DD
        const [day, month, year] = dateCell.textContent.split(": ")[1].split("/");
        const isoDate = `${year}-${month}-${day}`;

        // Verifica correspondências
        const customerName = customerCell.textContent.split(": ")[1].toLowerCase();
        const nameMatch = !searchName || customerName.includes(searchName);
        const dateMatch = !searchDate || isoDate === searchDate;

        // Exibe/oculta cards
        const parentCol = card.closest(".col-6");
        parentCol.style.display = (nameMatch && dateMatch) ? "" : "none";
        if (parentCol.style.display === "") hasVisibleItems = true;
      });

      noSalesMessage.style.display = hasVisibleItems ? "none" : "";
    }

    nameInput.addEventListener("input", filterSales);
    dateInput.addEventListener("input", filterSales);
  });
</script>
