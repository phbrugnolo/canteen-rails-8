<!-- Income metrics card custom configuration -->
<%
  revenue_value = @period_revenue || 0
  tag_class = revenue_value > 10000 ? "h4" : "h3"
%>

<div class="dashboard-container">
  <div class="dashboard-header">
    <h1 class="dashboard-title">
      <%= I18n.t(:dashboard) %>
    </h1>
    <p class="dashboard-subtitle text-muted">
      <%= I18n.t(:welcome_back) %>, <%= current_user&.name&.capitalize %>
    </p>
  </div>

  <!-- Metrics Cards -->
  <div class="metrics-grid">
    <div class="dashboard-metric-card">
      <div class="dashboard-metric-icon customers">
        <i class="bi bi-people-fill"></i>
      </div>
      <div class="dashboard-metric-content">
        <h3 class="dashboard-metric-value"><%= @total_customers %></h3>
        <p class="dashboard-metric-label"><%= I18n.t(:customer, scope: %i[activerecord models], count: 2) %></p>
        <small class="dashboard-metric-detail text-success">
          <%= @active_customers %> <%= I18n.t(:actives) %>
        </small>
      </div>
    </div>

    <div class="dashboard-metric-card">
      <div class="dashboard-metric-icon products">
        <i class="bi bi-box-seam-fill"></i>
      </div>
      <div class="dashboard-metric-content">
        <h3 class="dashboard-metric-value"><%= @total_products %></h3>
        <p class="dashboard-metric-label"><%= I18n.t(:product, scope: %i[activerecord models], count: 2) %></p>
        <small class="dashboard-metric-detail text-success">
          <%= @active_products %> <%= I18n.t(:actives) %>
        </small>
      </div>
    </div>

    <div class="dashboard-metric-card">
      <div class="dashboard-metric-icon sales">
        <i class="bi bi-cart-check-fill"></i>
      </div>
      <div class="dashboard-metric-content">
        <h3 class="dashboard-metric-value"><%= @total_sales %></h3>
        <p class="dashboard-metric-label"><%= I18n.t(:sale, scope: %i[activerecord models], count: 2) %></p>
        <small class="dashboard-metric-detail text-info">
          <%= I18n.t(:this_month) %>
        </small>
      </div>
    </div>

    <div class="dashboard-metric-card">
      <div class="dashboard-metric-icon revenue">
        <i class="bi bi-currency-dollar"></i>
      </div>
      <div class="dashboard-metric-content">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <%= content_tag tag_class.to_sym, class: "metric-value mb-0" do %>
            <%= number_to_currency(revenue_value) %>
          <% end %>
          <div class="dropup">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-funnel"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="min-width: 140px;">
              <li><%= link_to I18n.t(:today), request.path + "?period=today", class: "dropdown-item #{'active' if params[:period] == 'today'}" %></li>
              <li><%= link_to I18n.t(:this_month), request.path + "?period=this_month", class: "dropdown-item #{'active' if params[:period].blank? || params[:period] == 'this_month'}" %></li>
              <li><%= link_to I18n.t(:this_year), request.path + "?period=this_year", class: "dropdown-item #{'active' if params[:period] == 'this_year'}" %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to I18n.t(:all_period), request.path + "?period=all_time", class: "dropdown-item #{'active' if params[:period] == 'all_time'}" %></li>
            </ul>
          </div>
        </div>
        <p class="dashboard-metric-label"><%= I18n.t(:revenue) %></p>
        <small class="dashboard-metric-detail text-info">
          <%= case params[:period]
              when 'today' then I18n.t(:today)
              when 'this_year' then I18n.t(:this_year)
              when 'all_time' then I18n.t(:all_period)
              else I18n.t(:this_month)
              end %>
        </small>
      </div>
    </div>
  </div>

  <!-- Charts and Activity Section -->
  <div class="dashboard-content">
    <div class="row">
      <!-- Recent Sales -->
      <div class="col-lg-8">
        <div class="card dashboard-card">
          <div class="card-header">
            <h5 class="card-title mb-0">
              <i class="bi bi-clock-history me-2"></i>
              <%= I18n.t(:recent_sales) %>
            </h5>
          </div>
          <div class="card-body">
            <% if @recent_sales.any? %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th><%= I18n.t(:customer, scope: %i[activerecord models], count: 1) %></th>
                      <th><%= I18n.t(:date) %></th>
                      <th class="text-end"><%= I18n.t(:total_price) %></th>
                      <th class="text-center"><%= I18n.t(:actions) %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @recent_sales.each do |sale| %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center">
                            <div class="avatar-sm me-2">
                              <%= sale.customer.name.first.upcase %>
                            </div>
                            <%= sale.customer.name %>
                          </div>
                        </td>
                        <td>
                          <span class="text-muted">
                            <%= time_ago_in_words(sale.created_at) %> <%= I18n.t(:ago) %>
                          </span>
                        </td>
                        <td class="text-end">
                          <span class="badge bg-success">
                            <%= number_to_currency(sale.total_price) %>
                          </span>
                        </td>
                        <td class="text-center">
                          <%= link_to main_sale_path(sale), class: "btn btn-sm btn-outline-primary" do %>
                            <i class="bi bi-eye"></i>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <div class="text-center mt-3">
                <%= link_to main_sales_path, class: "btn btn-primary" do %>
                  <%= I18n.t(:view_all_sales) %>
                  <i class="bi bi-arrow-right ms-1"></i>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-4">
                <i class="bi bi-cart-x display-4 text-muted"></i>
                <p class="text-muted mt-2"><%= I18n.t(:no_recent_sales) %></p>
                <%= link_to I18n.t(:create_sale), new_main_sale_path, class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Quick Actions & Top Customers -->
      <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card dashboard-card mb-4">
          <div class="card-header">
            <h5 class="card-title mb-0">
              <i class="bi bi-lightning-fill me-2"></i>
              <%= I18n.t(:quick_actions) %>
            </h5>
          </div>
          <div class="card-body">
            <div class="d-grid gap-2">
              <%= link_to new_main_sale_path, class: "btn btn-primary" do %>
                <i class="bi bi-plus-circle me-2"></i>
                <%= I18n.t(:new_sale) %>
              <% end %>
              <%= link_to new_main_customer_path, class: "btn btn-outline-primary" do %>
                <i class="bi bi-person-plus me-2"></i>
                <%= I18n.t(:add, scope: %i[activerecord], model: Customer.model_name.human) %>
              <% end %>
              <%= link_to new_main_product_path, class: "btn btn-outline-primary" do %>
                <i class="bi bi-box-seam-fill me-2"></i>
                <%= I18n.t(:add, scope: %i[activerecord], model: Product.model_name.human) %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Top Customers -->
        <div class="card dashboard-card">
          <div class="card-header">
            <h5 class="card-title mb-0">
              <i class="bi bi-trophy-fill me-2"></i>
              <%= I18n.t(:top_customers) %>
            </h5>
          </div>
          <div class="card-body">
            <% if @top_customers.any? %>
              <% @top_customers.each_with_index do |customer, index| %>
                <div class="d-flex align-items-center mb-3">
                  <div class="rank-badge me-2">
                    <%= index + 1 %>
                  </div>
                  <div class="flex-grow-1">
                    <div class="fw-medium"><%= customer[:name] %></div>
                    <small class="text-success">
                      <%= number_to_currency(customer[:total]) %>
                    </small>
                  </div>
                </div>
                <% unless index == @top_customers.size - 1 %>
                  <hr class="my-2">
                <% end %>
              <% end %>
            <% else %>
              <div class="text-center py-3">
                <i class="bi bi-person-x display-6 text-muted"></i>
                <p class="text-muted mt-2 mb-0"><%= I18n.t(:no_customer_data) %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
