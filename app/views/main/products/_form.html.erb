<div class="form-container">
  <div class="form-card">
    <div class="form-header">
      <h2 class="form-title">
        <div class="form-icon">
          <i class="bi bi-box-seam"></i>
        </div>
        <%= @product.persisted? ? "Editar Produto" : "Novo Produto" %>
      </h2>
      <p class="form-subtitle">
        <%= @product.persisted? ? "Atualize as informações do produto" : "Preencha os dados do novo produto" %>
      </p>
    </div>

    <%= simple_form_for [:main, @product], html: { class: "simple_form" } do |f| %>
      <!-- Error notification with enhanced styling -->
      <% if @product.errors.any? %>
        <div class="form-notification error">
          <div class="notification-icon"></div>
          <div>
            <strong>Ops! Encontramos alguns problemas:</strong>
            <ul class="mb-0 mt-2">
              <% @product.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <!-- Product Name Field with Icon -->
      <div class="form-group form-group-with-icon">
        <%= f.label :name, class: "form-label required" do %>
          <i class="bi bi-tag"></i> <%= I18n.t(:name, scope: %i[activerecord attributes product]) %>
        <% end %>
        <%= f.input_field :name,
            class: "form-control",
            placeholder: "Ex: Hambúrguer Artesanal",
            required: true,
            autofocus: true %>
        <i class="form-icon bi bi-tag"></i>
      </div>

      <!-- Product Description Field -->
      <div class="form-group">
        <%= f.label :description, class: "form-label required" do %>
          <i class="bi bi-file-text"></i> <%= I18n.t(:description, scope: %i[activerecord attributes product]) %>
        <% end %>
        <%= f.input_field :description,
            as: :text,
            class: "form-control",
            placeholder: "Descreva o produto detalhadamente...",
            required: true,
            rows: 4 %>
      </div>

      <!-- Product Image Field with Enhanced File Upload -->
      <div class="form-group">
        <%= f.label :image, class: "form-label" do %>
          <i class="bi bi-image"></i> <%= I18n.t(:image, scope: %i[activerecord attributes product]) %>
        <% end %>
        <div class="form-file-upload">
          <%= f.input_field :image,
              as: :file,
              class: "file-upload-input",
              accept: "image/*" %>
          <label class="file-upload-label">
            <i class="upload-icon bi bi-cloud-upload"></i>
            <div class="upload-text">Clique para selecionar uma imagem</div>
            <div class="upload-hint">PNG, JPG ou JPEG (máx. 5MB)</div>
          </label>
        </div>
        <% if @product.image.attached? %>
          <div class="mt-2">
            <small class="text-muted">
              <i class="bi bi-check-circle text-success"></i>
              Imagem atual: <%= @product.image.filename %>
            </small>
          </div>
        <% end %>
      </div>

      <!-- Product Price Field with Icon -->
      <div class="form-group form-group-with-icon">
        <%= f.label :price, class: "form-label required" do %>
          <i class="bi bi-currency-dollar"></i> <%= I18n.t(:price, scope: %i[activerecord attributes product]) %>
        <% end %>
        <%= f.input_field :price,
            class: "form-control",
            placeholder: "0,00",
            required: true,
            step: 0.01,
            min: 0,
            value: @product.price ? number_with_precision(@product.price, precision: 2) : nil %>
        <i class="form-icon bi bi-currency-dollar"></i>
      </div>

      <!-- Form Actions -->
      <div class="form-actions">
        <%= link_to main_products_path, class: "btn btn-form-secondary" do %>
          <i class="btn-icon bi bi-arrow-left"></i>
          <%= I18n.t(:back, scope: %i[form actions]) %>
        <% end %>

        <%= f.button :submit, class: "btn btn-form-primary" do %>
          <i class="btn-icon bi bi-check-lg"></i>
          <%= @product.persisted? ? "Atualizar Produto" : I18n.t(:submit, scope: %i[form actions]) %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
