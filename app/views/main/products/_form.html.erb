<%= simple_form_for [:main, @product] do |f| %>
  <%= f.error_notification %>
  <%= f.input :name, placeholder: I18n.t(:name, scope: %i[activerecord attributes product]), required: true, autofocus: true, error: I18n.t(:blank, scope: %i[errors messages]) %>
  <%= f.input :description, required: true, placeholder: I18n.t(:description, scope: %i[activerecord attributes product]), error: I18n.t(:blank, scope: %i[errors messages]) %>
  <%= f.input :image, as: :file, label: I18n.t(:image, scope: %i[activerecord attributes product]) %>
  <%= f.input :price, required: true, value: number_with_precision(f.object.price, precision: 2), error: I18n.t(:greater_than, scope: %i[errors messages]) %>

  <%= link_to I18n.t(:back, scope: %i[form actions]), main_products_path %>
  <%= f.button :submit, I18n.t(:submit, scope: %i[form actions]) %>
<% end %>
