<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <style>
      @page {
        size: A4;
        margin: 0;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        font-size: 26px;
      }

      .promissory {
        width: 36cm;
        height: 14cm;
        margin: 1cm auto;
        border: 1px solid #000;
        position: relative;
        padding: 0.25cm;
      }

      .logo {
        position: absolute;
        top: 0.25cm;
        left: 1cm;
        width: 3.5cm;
        height: 3cm;
      }

      .header {
        text-align: center;
        margin-bottom: 1.75cm;
      }

      .header h3 {
        margin: 0;
      }

      .header .code {
        top: 0.3cm;
        left: 5.5cm;
        position: relative;
        margin-top: 0.2cm;
        font-weight: bold;
      }

      .field {
        margin-bottom: 0.5cm;
      }

      .field-line {
        display: flex;
        align-items: center;
        gap: 0.2cm;
        margin-bottom: 0.5cm;
      }

      .field-group {
        display: flex;
        gap: 1cm;
      }

      .underline {
        border-bottom: 1px solid #000;
        min-width: 3cm;
        display: inline-block;
        height: 1.2em;
      }

      .signature {
        margin-top: 1.5cm;
        text-align: center;
      }

      .signature-line {
        width: 24cm;
        border-bottom: 1px solid #000;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <% @customers.each do |customer| %>
      <div class="promissory">
        <div class="header">
          <%= wicked_pdf_image_tag "logo-lbv.png", class: 'logo' %>
          <div>
            <h3>ADIANTAMENTO SALARIAL</h3>
            <div class="code">Código: 1613</div>
          </div>
        </div>

        <div class="field-line">
          <span>R$</span>
          <span class="underline" style="width: 8cm;"><%= number_to_currency(customer.monthly_sales_total, unit: "") %></span>
          (<span class="underline" style="width: 26cm;"><%= number_to_words(customer.monthly_sales_total) %></span>)
        </div>

        <div class="field-line">
          <span>Desconto mês:</span>
          <span class="underline" style="width: 9cm;"></span>
          <span>/</span>
          <span class="underline" style="width: 2cm;"></span>
        </div>

        <div class="field-line">
          <span>Nome:</span>
          <span class="underline" style="width: 32cm;"><%= customer.name %></span>
        </div>

        <div class="field-group">
          <div class="field-line">
            <span>Matrícula:</span>
            <span class="underline" style="width: 10cm;"><%= customer.matriculation %></span>
            <span style="margin-left: 3cm;">CPF:</span>
            <span class="underline" style="width: 10cm;"></span>
          </div>
        </div>

        <div class="field-line">
          <span>Data:</span>
          <span class="underline" style="width: 1cm;"></span>/
          <span class="underline" style="width: 1cm;"></span>/
          <span class="underline" style="width: 1cm;"></span>
        </div>

        <div class="signature">
          <div class="signature-line"></div>
          <div>Assinatura</div>
        </div>
      </div>
    <% end %>
  </body>
</html>
