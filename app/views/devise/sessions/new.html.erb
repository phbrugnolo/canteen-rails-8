<div class="auth-container">
  <div class="auth-form-container">
    <h2 class="auth-heading">Log in</h2>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= simple_form_for(resource, as: resource_name, url: user_session_path) do |f| %>
      <div class="form-inputs">
        <%= f.input :name,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "name", class: "form-control" } %>
        <%= f.input :password,
                  required: false,
                  input_html: { autocomplete: "current-password", class: "form-control" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in", class: "btn btn-primary auth-btn" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
