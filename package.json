{
  "name": "app",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.29.0",
    "globals": "^16.2.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:css:compile": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css": "yarn build:css:compile && yarn build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss,css --exec \"yarn build:css\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@rails/ujs": "7.1.501",
    "autoprefixer": "^10.4.21",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.89.2",
    "sweetalert2": "^11.22.1",
    "tom-select": "^2.4.3"
  },
  "browserslist": [
    "defaults"
  ],
  "packageManager": "yarn@4.9.2"
}
