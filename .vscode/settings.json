{
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.autoGuessEncoding": true,
  "editor.detectIndentation": false,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "emmet.includeLanguages": {
    "erb": "html"
  },
  "cSpell.words": [
    "activatable",
    "Activatable",
    "activerecord",
    "beforeunload",
    "csrf",
    "onclick",
    "pagehide",
    "rgba",
    "swal",
    "Swal",
    "sweetalert",
    "sweetalert2",
    "tbody",
    "thead"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/.yarn": true,
    "**/vendor": true,
    "**/tmp": true,
    "**/log": true,
    "**/storage": true,
    "**/.git": true,
    "**/coverage": true,
    "**/*.log": true,
    "**/app/assets/builds": true,
    "**/.bundle": true,
    "**/Gemfile.lock": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true
  }
}
